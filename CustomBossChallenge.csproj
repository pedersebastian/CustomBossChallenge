<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <RootNamespace>CustomBossChallenge</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <Nullable>enable</Nullable>
        <AssemblyName>CustomBossChallenge</AssemblyName>
        <LangVersion>preview</LangVersion>
        <!-- Off in Release too, on purpose: the released IL stays like the Debug build the tests ran on (CONTRIBUTING.md) -->
        <Optimize>False</Optimize>
        <DebugType>embedded</DebugType>
        <!-- build.yml is our own (it checks before it releases, see CONTRIBUTING.md), so Mod Helper must not write it again -->
        <GenerateActionsWorkflow>false</GenerateActionsWorkflow>
    </PropertyGroup>
    <ItemGroup>
        <Content Include=".github\workflows\build.yml" />
    </ItemGroup>

    <Import Project="..\btd6.targets" />

    <!-- Claude Code's worktrees are whole copies of the repository, Unity project included: never part of the build -->
    <ItemGroup>
        <Compile Remove=".claude\**" />
        <EmbeddedResource Remove=".claude\**" />
        <None Remove=".claude\**" />
    </ItemGroup>

    <!-- README screenshots are not mod resources; the README itself is, so the tests can check its example codes -->
    <ItemGroup>
        <EmbeddedResource Remove="docs\**" />
        <EmbeddedResource Include="README.md" LogicalName="CustomBossChallenge.README.md" />
    </ItemGroup>

    <!-- The CHIMPS boss events' round sets, which the game doesn't have (#139) -->
    <ItemGroup>
        <EmbeddedResource Include="Config\RoundSets\chimpsbloonarius.json" LogicalName="CustomBossChallenge.chimpsbloonarius.json" />
        <EmbeddedResource Include="Config\RoundSets\chimpsboss.json" LogicalName="CustomBossChallenge.chimpsboss.json" />
        <EmbeddedResource Include="Config\RoundSets\gildebloon.json" LogicalName="CustomBossChallenge.gildebloon.json" />
        <!-- How Gildebloon's parts sit together, made with Bundles/gildebloon.bundle by UnityProject (#25) -->
        <EmbeddedResource Include="Bundles\gildebloon.layout.json" LogicalName="CustomBossChallenge.gildebloon.layout.json" />
        <!-- Gildebloon's pile of money, modelled in Blender: tools/blender/build-pile.py (#25) -->
        <EmbeddedResource Include="Bundles\gildebloon-pile.mesh.gz" LogicalName="CustomBossChallenge.gildebloon-pile.mesh.gz" />
        <!-- Gildebloon's body and animations, made in Blender: tools/blender/build-boss.py (#25) -->
        <EmbeddedResource Include="Bundles\gildebloon-body.gba.gz" LogicalName="CustomBossChallenge.gildebloon-body.gba.gz" />
        <!-- The gold oozing in round the map's edges, Gildebloon's effect on the map: tools/blender/build-map.py (#25) -->
        <EmbeddedResource Include="Bundles\gildebloon-map.gba.gz" LogicalName="CustomBossChallenge.gildebloon-map.gba.gz" />
    </ItemGroup>

    <!-- The website is its own project. Only the data it gets from the game is built in, so WebDataTest can check it,
         and only in Debug builds, which the tests run on: the released mod doesn't carry it -->
    <ItemGroup>
        <Compile Remove="web\**" />
        <EmbeddedResource Remove="web\**" />
        <None Remove="web\**" />
        <EmbeddedResource Include="web\src\data\*.json" LogicalName="CustomBossChallenge.web.%(Filename)%(Extension)"
                          Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <!-- The Past Events list's copy of boss-events.json (#146), built from data/boss-events/ by Node and gzipped, so a
         release has every event up to its build without downloading anything. It is made in obj/ and never
         committed, so the archiver's daily commits don't change the source hash of the in-game tests. Without Node a
         Debug build only warns (the mod then has the downloaded copy only); a Release build fails, so no release is
         made without it. -->
    <PropertyGroup>
        <BossEventsBundle>$(BaseIntermediateOutputPath)$(Configuration)\boss-events.json.gz</BossEventsBundle>
    </PropertyGroup>
    <ItemGroup>
        <BossEventFile Include="data\boss-events\*.json" />
        <BossEventFile Include="tools\boss-events\*.mjs" Exclude="tools\boss-events\*.test.mjs" />
    </ItemGroup>
    <Target Name="FindNode" BeforeTargets="BuildBossEventsBundle">
        <Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low"
              EchoOff="true">
            <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
        </Exec>
        <Error Condition="'$(NodeExitCode)' != '0' And '$(Configuration)' == 'Release'"
               Text="Node.js is needed to build the copy of boss-events.json a release carries (#146). Install Node 24 and build again." />
        <Warning Condition="'$(NodeExitCode)' != '0' And '$(Configuration)' != 'Release'"
                 Text="Node.js wasn't found, so this build has no copy of boss-events.json: the Past Events list only has the downloaded one (#146)." />
    </Target>
    <Target Name="BuildBossEventsBundle" BeforeTargets="BeforeBuild" Inputs="@(BossEventFile)" Outputs="$(BossEventsBundle)">
        <Exec Command="node &quot;$(MSBuildProjectDirectory)/tools/boss-events/archive.mjs&quot; --bundle &quot;$(BossEventsBundle)&quot;"
              WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'$(NodeExitCode)' == '0'" />
    </Target>
    <Target Name="EmbedBossEventsBundle" AfterTargets="BuildBossEventsBundle" BeforeTargets="BeforeBuild"
            Condition="Exists('$(BossEventsBundle)')">
        <ItemGroup>
            <EmbeddedResource Include="$(BossEventsBundle)" LogicalName="CustomBossChallenge.boss-events.json.gz" />
        </ItemGroup>
    </Target>

    <!-- Debug builds, which the in-game tests run on, know which code they were built from, so the tests can write it to
         TestResults/ingame.json for Check-Release.ps1 (see CONTRIBUTING.md). Release builds don't carry the author's
         folder or commit. -->
    <Target Name="EmbedTestedSource" BeforeTargets="GetAssemblyAttributes" Condition="'$(Configuration)' == 'Debug'">
        <PropertyGroup>
            <PowerShell Condition="'$(OS)' == 'Windows_NT'">powershell -NoProfile -ExecutionPolicy Bypass</PowerShell>
            <PowerShell Condition="'$(OS)' != 'Windows_NT'">pwsh -NoProfile</PowerShell>
        </PropertyGroup>
        <Exec Command="$(PowerShell) -File &quot;$(MSBuildProjectDirectory)/.github/scripts/Get-SourceHash.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)&quot;"
              ConsoleToMSBuild="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="TestedSourceHash" />
        </Exec>
        <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true"
              WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ConsoleOutput" PropertyName="TestedCommit" />
        </Exec>
        <Exec Command="git status --porcelain" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true"
              WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ConsoleOutput" PropertyName="TestedChanges" />
        </Exec>
        <PropertyGroup>
            <TestedDirty>false</TestedDirty>
            <TestedDirty Condition="'$(TestedChanges)' != ''">true</TestedDirty>
        </PropertyGroup>
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CBC.SourceHash</_Parameter1>
                <_Parameter2>$(TestedSourceHash)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CBC.Commit</_Parameter1>
                <_Parameter2>$(TestedCommit)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CBC.Dirty</_Parameter1>
                <_Parameter2>$(TestedDirty)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CBC.RepoRoot</_Parameter1>
                <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <!-- The Unity project only builds the shader bundle (see CONTRIBUTING.md); Bundles\tierlook.bundle, which it makes,
         is built in like every *.bundle -->
    <ItemGroup>
        <Compile Remove="UnityProject\**" />
        <EmbeddedResource Remove="UnityProject\**" />
        <None Remove="UnityProject\**" />
    </ItemGroup>

    <!-- The unit and property tests, and the game-free files they share, are their own projects -->
    <ItemGroup>
        <Compile Remove="UnitTests\**;PropertyTests\**;Shared\**" />
        <EmbeddedResource Remove="UnitTests\**;PropertyTests\**;Shared\**" />
        <None Remove="UnitTests\**;PropertyTests\**;Shared\**" />
    </ItemGroup>
</Project>
