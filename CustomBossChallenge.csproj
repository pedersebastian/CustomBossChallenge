<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <RootNamespace>CustomBossChallenge</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <Nullable>enable</Nullable>
        <AssemblyName>CustomBossChallenge</AssemblyName>
        <LangVersion>preview</LangVersion>
        <!-- Off in Release too, on purpose: the released IL stays like the Debug build the tests ran on (CONTRIBUTING.md) -->
        <Optimize>False</Optimize>
        <DebugType>embedded</DebugType>
        <!-- build.yml is our own (it checks before it releases, see CONTRIBUTING.md), so Mod Helper must not write it again -->
        <GenerateActionsWorkflow>false</GenerateActionsWorkflow>
    </PropertyGroup>
    <ItemGroup>
        <Content Include=".github\workflows\build.yml" />
    </ItemGroup>

    <Import Project="..\btd6.targets" />

    <!-- README screenshots are not mod resources; the README itself is, so the tests can check its example codes -->
    <ItemGroup>
        <EmbeddedResource Remove="docs\**" />
        <EmbeddedResource Include="README.md" LogicalName="CustomBossChallenge.README.md" />
    </ItemGroup>

    <!-- The website is its own project. Only the data it gets from the game is built in, so WebDataTest can check it,
         and only in Debug builds, which the tests run on: the released mod doesn't carry it -->
    <ItemGroup>
        <Compile Remove="web\**" />
        <EmbeddedResource Remove="web\**" />
        <None Remove="web\**" />
        <EmbeddedResource Include="web\src\data\*.json" LogicalName="CustomBossChallenge.web.%(Filename)%(Extension)"
                          Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <!-- Debug builds, which the in-game tests run on, know which code they were built from, so the tests can write it to
         TestResults/ingame.json for Check-Release.ps1 (see CONTRIBUTING.md). Release builds don't carry the author's
         folder or commit. -->
    <Target Name="EmbedTestedSource" BeforeTargets="GetAssemblyAttributes" Condition="'$(Configuration)' == 'Debug'">
        <PropertyGroup>
            <PowerShell Condition="'$(OS)' == 'Windows_NT'">powershell -NoProfile -ExecutionPolicy Bypass</PowerShell>
            <PowerShell Condition="'$(OS)' != 'Windows_NT'">pwsh -NoProfile</PowerShell>
        </PropertyGroup>
        <Exec Command="$(PowerShell) -File &quot;$(MSBuildProjectDirectory)/.github/scripts/Get-SourceHash.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)&quot;"
              ConsoleToMSBuild="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="TestedSourceHash" />
        </Exec>
        <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true"
              WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ConsoleOutput" PropertyName="TestedCommit" />
        </Exec>
        <Exec Command="git status --porcelain" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true"
              WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ConsoleOutput" PropertyName="TestedChanges" />
        </Exec>
        <PropertyGroup>
            <TestedDirty>false</TestedDirty>
            <TestedDirty Condition="'$(TestedChanges)' != ''">true</TestedDirty>
        </PropertyGroup>
        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CBC.SourceHash</_Parameter1>
                <_Parameter2>$(TestedSourceHash)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CBC.Commit</_Parameter1>
                <_Parameter2>$(TestedCommit)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CBC.Dirty</_Parameter1>
                <_Parameter2>$(TestedDirty)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>CBC.RepoRoot</_Parameter1>
                <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>
    </Target>

    <!-- The Unity project only builds the shader bundle (see CONTRIBUTING.md); Bundles\tierlook.bundle, which it makes,
         is built in like every *.bundle -->
    <ItemGroup>
        <Compile Remove="UnityProject\**" />
        <EmbeddedResource Remove="UnityProject\**" />
        <None Remove="UnityProject\**" />
    </ItemGroup>

    <!-- The unit and property tests, and the game-free files they share, are their own projects -->
    <ItemGroup>
        <Compile Remove="UnitTests\**;PropertyTests\**;Shared\**" />
        <EmbeddedResource Remove="UnitTests\**;PropertyTests\**;Shared\**" />
        <None Remove="UnitTests\**;PropertyTests\**;Shared\**" />
    </ItemGroup>
</Project>
