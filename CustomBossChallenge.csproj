<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <RootNamespace>CustomBossChallenge</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <Nullable>enable</Nullable>
        <AssemblyName>CustomBossChallenge</AssemblyName>
        <LangVersion>preview</LangVersion>
        <Optimize>False</Optimize>
        <DebugType>embedded</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <Content Include=".github\workflows\build.yml" />
    </ItemGroup>

    <Import Project="..\btd6.targets" />

    <!-- README screenshots are not mod resources; the README itself is, so the tests can check its example codes -->
    <ItemGroup>
        <EmbeddedResource Remove="docs\**" />
        <EmbeddedResource Include="README.md" LogicalName="CustomBossChallenge.README.md" />
    </ItemGroup>

    <!-- The unit tests are their own project -->
    <ItemGroup>
        <Compile Remove="UnitTests\**" />
        <EmbeddedResource Remove="UnitTests\**" />
        <None Remove="UnitTests\**" />
    </ItemGroup>
</Project>
