    {
      "name": "Boss Health 5 on its own",
      "facts": { "BossHealth": 5 },
      "warnings": []
    },
    {
      "name": "Fast, tough bloons on Impoppable with few towers",
      "facts": { "Mode": "Impoppable", "Difficulty": "Hard", "BloonHealth": 2, "MoabHealth": 2, "MaxTowers": 5 },
      "warnings": ["HardSetup"]
    },
    {
