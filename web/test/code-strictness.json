{
  "about": "Codes the mod and the website must read the same way (#174). Each side packs json with its own deflate, then changes the code text: codePrefix and codeSuffix go around it, codeInsert goes after the first 8 Base64 characters, codeCut takes Base64 characters off the end. ok: the code loads and its options are read. Read by UnitTests/CodeFormatTests.cs and web/test/code-strictness.test.ts.",
  "cases": [
    {"name": "plain JSON", "json": "{\"o\":{\"Tiers\":3},\"c\":{}}", "ok": true, "tiers": 3},
    {"name": "single quotes", "json": "{'o':{'Tiers':3}}", "ok": false},
    {"name": "trailing comma", "json": "{\"o\":{\"Tiers\":3,},\"c\":{}}", "ok": false},
    {"name": "comment", "json": "{\"o\":{\"Tiers\":3}/* hi */,\"c\":{}}", "ok": false},
    {"name": "line comment", "json": "{\"o\":{\"Tiers\":3},\"c\":{}}// hi", "ok": false},
    {"name": "name without quotes", "json": "{o:{\"Tiers\":3},\"c\":{}}", "ok": false},
    {"name": "octal number", "json": "{\"o\":{\"Tiers\":010},\"c\":{}}", "ok": false},
    {"name": "hex number", "json": "{\"o\":{\"Tiers\":0x3},\"c\":{}}", "ok": false},
    {"name": "undefined", "json": "{\"o\":{\"SpawnRounds\":undefined},\"c\":{}}", "ok": false},
    {"name": "NaN", "json": "{\"o\":{\"Tiers\":NaN},\"c\":{}}", "ok": false},
    {"name": "Infinity", "json": "{\"o\":{},\"c\":{\"cash\":Infinity}}", "ok": false},
    {"name": "number too large for a double", "json": "{\"o\":{},\"c\":{\"cash\":1e400}}", "ok": true},
    {"name": "minus zero", "json": "{\"o\":{\"Tiers\":-0},\"c\":{}}", "ok": true},
    {"name": "same name twice, the last counts", "json": "{\"o\":{\"Tiers\":3,\"Tiers\":4},\"c\":{}}", "ok": true, "tiers": 4},
    {"name": "white space around the JSON", "json": " \t\r\n{\"o\":{},\"c\":{}}\n", "ok": true},
    {"name": "no-break space around the JSON", "json": "\u00a0{\"o\":{},\"c\":{}}", "ok": false},
    {"name": "byte order mark before the JSON", "json": "\ufeff{\"o\":{},\"c\":{}}", "ok": true},
    {"name": "line break inside a string", "json": "{\"o\":{},\"c\":{\"name\":\"a\nb\"}}", "ok": false},
    {"name": "escaped line break and NUL inside a string", "json": "{\"o\":{},\"c\":{\"name\":\"a\\nb\\u0000\"}}", "ok": true},
    {"name": "text after the JSON", "json": "{\"o\":{},\"c\":{}}x", "ok": false},
    {"name": "nested 64 deep", "json": "{\"o\":{},\"c\":{\"x\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}}", "ok": true},
    {"name": "nested 65 deep", "json": "{\"o\":{},\"c\":{\"x\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}}", "ok": false},
    {"name": "nested 72 deep", "json": "{\"o\":{},\"c\":{\"x\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}}", "ok": false},
    {"name": "brackets in text don't nest", "json": "{\"o\":{},\"c\":{\"name\":\"[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[\"}}", "ok": true},
    {"name": "AAAA after the code", "json": "{\"o\":{},\"c\":{}}", "codeSuffix": "AAAA", "ok": false},
    {"name": "A after the code", "json": "{\"o\":{},\"c\":{}}", "codeSuffix": "A", "ok": false},
    {"name": "two CRLFs inside the code", "json": "{\"o\":{},\"c\":{}}", "codeInsert": "\r\n\r\n", "ok": false},
    {"name": "space inside the code", "json": "{\"o\":{},\"c\":{}}", "codeInsert": " ", "ok": false},
    {"name": "code cut short", "json": "{\"o\":{\"SpawnRounds\":\"40, 60, 80, 100, 120\",\"Tiers\":5},\"c\":{}}", "codeCut": 4, "ok": false},
    {"name": "padding at the end", "json": "{\"o\":{},\"c\":{}}", "codeSuffix": "==", "ok": false},
    {"name": "U+0085 after the code", "json": "{\"o\":{},\"c\":{}}", "codeSuffix": "\u0085", "ok": true},
    {"name": "no-break space before the code", "json": "{\"o\":{},\"c\":{}}", "codePrefix": "\u00a0", "ok": true},
    {"name": "byte order mark before the code", "json": "{\"o\":{},\"c\":{}}", "codePrefix": "\ufeff", "ok": false},
    {"name": "byte order mark after the code", "json": "{\"o\":{},\"c\":{}}", "codeSuffix": "\ufeff", "ok": false},
    {"name": "no-break space and byte order mark in SpawnRounds", "json": "{\"o\":{\"Tiers\":3,\"SpawnRounds\":\"\\u00a040,\\ufeff75\"},\"c\":{}}", "ok": true, "spawnRounds": [40, 60, 80]},
    {"name": "U+0085 in SpawnRounds", "json": "{\"o\":{\"Tiers\":2,\"SpawnRounds\":\"30,\\u008550\"},\"c\":{}}", "ok": true, "spawnRounds": [30, 50]},
    {"name": "U+0085 after CustomSkulls", "json": "{\"o\":{\"SkullMode\":\"Custom\",\"CustomSkulls\":\"50, 25\\u0085\"},\"c\":{}}", "ok": true, "customSkulls": [0.5, 0.25]},
    {"name": "byte order mark in CustomSkulls", "json": "{\"o\":{\"SkullMode\":\"Custom\",\"CustomSkulls\":\"\\ufeff50\"},\"c\":{}}", "ok": true, "customSkulls": [0.75, 0.5, 0.25]},
    {"name": "tab before % in CustomSkulls", "json": "{\"o\":{\"SkullMode\":\"Custom\",\"CustomSkulls\":\"50\\t%\"},\"c\":{}}", "ok": true, "customSkulls": [0.5]},
    {"name": "Kelvin sign in a tier boss", "json": "{\"o\":{\"Tiers\":2,\"TierBosses\":\"Diamondbac\\u212a,lych\"},\"c\":{}}", "ok": true, "tierBosses": [[null, false], ["Lych", false]]},
    {"name": "dotless i in a tier boss", "json": "{\"o\":{\"Tiers\":2,\"TierBosses\":\"Bloonar\\u0131us,Lych\"},\"c\":{}}", "ok": true, "tierBosses": [[null, false], ["Lych", false]]},
    {"name": "dotless i in Elite", "json": "{\"o\":{\"Tiers\":2,\"TierBosses\":\"LychEl\\u0131te,Lych\"},\"c\":{}}", "ok": true, "tierBosses": [[null, false], ["Lych", false]]},
    {"name": "tier boss in any ASCII case", "json": "{\"o\":{\"Tiers\":1,\"TierBosses\":\" bLOONARIUSelite \"},\"c\":{}}", "ok": true, "tierBosses": [["Bloonarius", true]]},
    {"name": "no-break space around a tier boss", "json": "{\"o\":{\"Tiers\":1,\"TierBosses\":\"\\u00a0Vortex\\u00a0\"},\"c\":{}}", "ok": true, "tierBosses": [["Vortex", false]]},
    {"name": "byte order mark before a tier boss", "json": "{\"o\":{\"Tiers\":2,\"TierBosses\":\"\\ufeffVortex,Lych\"},\"c\":{}}", "ok": true, "tierBosses": [[null, false], ["Lych", false]]},
    {"name": "whole number as text", "json": "{\"o\":{\"Tiers\":\" 4\\n\"},\"c\":{}}", "ok": true, "tiers": 4},
    {"name": "no-break space around a whole number", "json": "{\"o\":{\"Tiers\":\"\\u00a04\"},\"c\":{}}", "ok": false},
    {"name": "boss name as text with spaces", "json": "{\"o\":{\"Boss\":\" lych \"},\"c\":{}}", "ok": true},
    {"name": "no-break space around a boss name", "json": "{\"o\":{\"Boss\":\"\\u00a0Lych\"},\"c\":{}}", "ok": false},
    {"name": "long s in a boss name", "json": "{\"o\":{\"Boss\":\"Bla\\u017ftapopoulos\"},\"c\":{}}", "ok": false}
  ]
}
